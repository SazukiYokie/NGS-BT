rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == 'awJRagh6wWhjEkpfyu6qbedWEUG3';
    }

    // Private student data: only the owner can read or write
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Class card: every signed-in classmate can read, only you can write your own
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoURL', 'status', 'studyStreak', 'avgBand', 'points', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && (
             resource == null
             || (request.resource.data.points >= resource.data.points
                 && request.resource.data.points - resource.data.points <= 100)
           );
      allow delete: if isAdmin();
    }

    // Shared class AI keys: everyone signed in can read; only YOUR account can change them
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
